#! /home/hutch/sw/Foundry/Nuke16.0v4/libnuke-16.0.4.so -nx
#write_info GradeOutput file:"/tmp/placeholder.png" format:"2048 1556 1" chans:":rgba.red:rgba.green:rgba.blue:" framerange:"1 100" fps:"0" colorspace:"default" datatype:"8 bit" transfer:"unknown" views:"main" colorManagement:"Nuke"
version 16.0 v4
Root {
 inputs 0
 gsv  {
  __default__ {
  } 
}
 format "2048 1556 0 0 2048 1556 1 2K_Super_35(full-ap)"
 proxy_type scale
 proxy_format "1024 778 0 0 1024 778 1 1K_Super_35(full-ap)"
 colorManagement Nuke
 workingSpaceLUT 0
 monitorLut sRGB
 monitorOutLUT rec709
 int8Lut 0
 int16Lut 0
 logLut 0
 floatLut 0
}
Read {
 inputs 0
 name GradeInput
 addUserKnob {20 User}
 addUserKnob {1 gt_role l "Griptape Role"}
 gt_role input
 addUserKnob {1 gt_name l "Griptape Name"}
 gt_name source_image
 addUserKnob {1 gt_type l "Griptape Type"}
 gt_type ImageArtifact
 addUserKnob {1 gt_label l "Griptape Label"}
 gt_label "Source Image"
}
Write {
 file /tmp/placeholder.png
 file_type png
 checkHashOnRead false
 ocioColorspace scene_linear
 display default
 view sRGB
 name GradeOutput
 selected true
 addUserKnob {20 User}
 addUserKnob {1 gt_role l "Griptape Role"}
 gt_role output
 addUserKnob {1 gt_name l "Griptape Name"}
 gt_name graded_image
 addUserKnob {1 gt_type l "Griptape Type"}
 gt_type ImageArtifact
}
